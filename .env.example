# Service configuration
IISA_HOST=0.0.0.0
IISA_PORT=8080
IISA_LOG_LEVEL=INFO
SCORES_FILE_PATH=/app/scores/indexer_scores.json

# -------------------------------------------------------------------
# Kubernetes secrets (create via kubectl, not committed to git)
# -------------------------------------------------------------------
#
# Redpanda and network subgraph credentials (secret: iisa-redpanda-credentials). The subgraph
# URL contains an API key; get one at https://thegraph.com/studio/apikeys/. The last key is
# optional: the gateway API key the freshness prober pays its checks with.
#   kubectl create secret generic iisa-redpanda-credentials \
#     --namespace=subgraph-dips-indexer-selection-iisa-daily-cronjob-samuel \
#     --from-literal=REDPANDA_BOOTSTRAP_SERVERS=<servers> \
#     --from-literal=REDPANDA_SASL_USERNAME=<username> \
#     --from-literal=REDPANDA_SASL_PASSWORD=<password> \
#     --from-literal=GRAPH_NETWORK_SUBGRAPH_URL=https://gateway.thegraph.com/api/<API_KEY>/subgraphs/id/DZz4kDTdmzWLWsV373w2bSmoar3umKKH9y82SUKr5qmp \
#     --from-literal=FRESHNESS_GATEWAY_API_KEY=<API_KEY>
